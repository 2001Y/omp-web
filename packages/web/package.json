{
	"type": "module",
	"name": "@oh-my-pi/web",
	"version": "18.13.2",
	"private": true,
	"description": "Web GUI host for the omp coding agent: serves the vendored dsh-web client stack and bridges the browser RPC contract onto an injected WebDriver",
	"homepage": "https://omp.sh",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"author": "Stencil Labs, Inc.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/web"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"keywords": [
		"web",
		"gui",
		"server",
		"agent"
	],
	"scripts": {
		"test": "bun test --parallel",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-utils": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"test",
		"README.md",
		"CHANGELOG.md"
	]
}
